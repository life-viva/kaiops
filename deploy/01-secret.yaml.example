# 复制为 01-secret.yaml 放在 master 的 /root/secrets/ 下（不进 git、不在代码同步区内），
# 填入真实 key 后执行: kubectl apply -f /root/secrets/01-secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: llm-secret
  namespace: kaiops
type: Opaque
stringData:
  LLM_API_KEY: "sk-REPLACE-ME"         # DeepSeek 平台的 key
  EMBED_API_KEY: "sk-REPLACE-ME-TOO"   # 硅基流动 siliconflow.cn 的 key
